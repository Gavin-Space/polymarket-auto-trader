# ============================================
# Polymarket Auto-Trader Configuration (reference)
# ============================================
# The web dashboard stores the important tunables in trading_config.json
# (auto-created on first run). This .env is only a reference — auto_trader.py
# reads bankroll / thresholds / filters from trading_config.json.

# --- Wallet (required for trading) ---
PRIVATE_KEY=0x_your_private_key_here
FUNDER_ADDRESS=0x_your_wallet_address_here
SIGNATURE_TYPE=2

# --- Trading Parameters ---
TRADING_MODE=dry_run
BANKROLL_USDC=200

# --- Scan Interval (seconds) ---
SCAN_INTERVAL=300

# --- Telegram Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- XTracker URL for tweet data ---
XTRACKER_URL=https://xtracker.polymarket.com
