# ============================================
# Polymarket Auto-Trader Configuration
# ============================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# --- Wallet (required for trading) ---
# Your Polygon wallet private key (starts with 0x)
# Get this from your wallet (MetaMask: Account Details > Export Private Key)
PRIVATE_KEY=0x_your_private_key_here

# Your wallet address (the public address, starts with 0x)
# For Proxy/Magic wallet users: this is your proxy address
FUNDER_ADDRESS=0x_your_wallet_address_here

# Signature type: 0=EOA, 1=Magic, 2=Proxy
# Most users: 2 (Proxy wallet via Polymarket registration)
SIGNATURE_TYPE=2

# --- API Credentials (optional, auto-derived on first run) ---
# After first run, the bot will print your API creds.
# Paste them here to skip re-deriving each time.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# --- Trading Parameters ---
# Mode: dry_run (no real trades) or live
TRADING_MODE=dry_run

# Total bankroll in USDC (the bot will manage positions within this)
BANKROLL_USDC=200

# Maximum position size as % of bankroll (0.05 = 5%)
MAX_POSITION_PCT=0.05

# Maximum total exposure as % of bankroll (0.70 = 70%)
MAX_TOTAL_EXPOSURE_PCT=0.70

# Cash reserve % (always keep this much in cash)
CASH_RESERVE_PCT=0.30

# Maximum number of concurrent positions
MAX_POSITIONS=10

# Daily loss limit % (stop trading if down this much in a day)
DAILY_LOSS_LIMIT_PCT=0.10

# Minimum market volume in USDC (only trade markets above this)
MIN_MARKET_VOLUME=10000

# Minimum order size in shares (Polymarket requires >= 5)
MIN_ORDER_SIZE=5

# --- Strategy Toggles (1=enable, 0=disable) ---
STRATEGY_EXPIRY_YIELD=1      # A: Buy NO on near-expiry high-probability markets
STRATEGY_TWEET_PREDICTION=1   # B: Musk tweet count prediction
STRATEGY_ARBITRAGE=1          # E: YES+NO arbitrage when combined < $0.98
STRATEGY_DIRECTIONAL=0        # D: Directional bets (requires manual config)

# --- Scan Interval (seconds) ---
SCAN_INTERVAL=300  # 5 minutes between full market scans

# --- Telegram Notifications (optional) ---
# Create a bot via @BotFather, get the token, and your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- XTracker URL for tweet data ---
XTRACKER_URL=https://xtracker.polymarket.com
